{
  "name": "osint-mcp-server",
  "version": "0.2.0",
  "description": "OSINT intelligence MCP server — Shodan, VirusTotal, SecurityTrails, Censys, DNS, WHOIS, crt.sh, Wayback, BGP",
  "type": "module",
  "bin": {
    "osint-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "action.yml"
  ],
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp", "model-context-protocol", "osint", "open-source-intelligence",
    "reconnaissance", "recon", "security", "cybersecurity", "infosec",
    "penetration-testing", "pentest", "bug-bounty", "threat-intelligence",
    "attack-surface", "subdomain-enumeration", "domain-intelligence",
    "shodan", "virustotal", "censys", "securitytrails",
    "dns", "whois", "bgp", "geoip", "wayback-machine", "crtsh",
    "certificate-transparency", "ip-lookup", "hackertarget",
    "ai", "ai-agent", "claude", "llm"
  ],
  "author": "Orhan Yildirim <contact@orhanyildirim.us> (https://orhanyildirim.us)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/badchars/osint-mcp-server.git"
  },
  "homepage": "https://github.com/badchars/osint-mcp-server",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.2"
  }
}
